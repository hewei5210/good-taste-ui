{
  "name": "shadcn-ui-kit",
  "version": "0.1.0",
  "private": false,
  "description": "Personal shadcn/ui component library built with React 19, Vite 7, Tailwind CSS v4 and Storybook.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "build:lib": "tsc -b && vite build",
    "preview": "vite preview",
    "add:component": "pnpm dlx shadcn@latest add",
    "format": "biome format --write ."
  },
  "keywords": [
    "shadcn",
    "ui",
    "component-library",
    "react",
    "tailwindcss",
    "storybook"
  ],
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.6"
  },
  "devDependencies": {
    "@storybook/addon-themes": "^10.4.6",
    "@storybook/react-vite": "^10.4.6",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "storybook": "^10.4.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.7"
  },
  "packageManager": "pnpm@10.18.0",
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
